{
  "name": "@shadcnstore/dashboard-kit",
  "version": "1.1.1",
  "description": "The ShadcnStore Dashboard Kit: the shared base (shell, customizer, settings, data, shaders) this template is built on. It is yours to edit. This file lists what kit/ needs from the rest of the app.",
  "requires": {
    "modules": {
      "lib/utils.ts": "exports cn(...classes), as shadcn init writes it",
      "lib/clock.ts": "exports currentTime(): Date, the template's pinned demo clock"
    },
    "ui": ["alert", "alert-dialog", "avatar", "badge", "breadcrumb", "button", "card", "chart", "checkbox", "collapsible", "command", "dialog", "dropdown-menu", "empty", "field", "input", "input-group", "input-otp", "item", "kbd", "label", "native-select", "navigation-menu", "popover", "progress", "scroll-area", "select", "separator", "sheet", "sidebar", "skeleton", "spinner", "switch", "table", "tabs", "textarea", "toast", "toggle", "toggle-group", "tooltip"],
    "dependencies": {
      "@base-ui/react": "^1.8.0",
      "@tanstack/react-query": "^5.104.0",
      "@tanstack/react-table": "^9.2.4",
      "lucide-react": "^1.48.0",
      "next-themes": "^0.4.6",
      "nuqs": "^2.10.1",
      "react": "19.2.8",
      "react-dom": "19.2.8",
      "recharts": "3.8.0",
      "tw-animate-css": "^1.4.0",
      "zustand": "^5.0.15"
    }
  },
  "frameworks": {
    "next": {
      "description": "Next.js App Router (the default edition).",
      "files": {},
      "dependencies": {
        "next": "16.3.4"
      }
    },
    "vite": {
      "description": "Vite + React Router, client-rendered. kit-sync --framework vite.",
      "files": {
        "framework/index.tsx": "framework/react-router.tsx"
      },
      "dependencies": {
        "react-router": "^8.4.0",
        "vite": "^8.3.4"
      }
    }
  }
}
